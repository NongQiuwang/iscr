<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.vsu.iscr.mapper.ReservationMapper">

    <resultMap id="ReservationResult" type="com.vsu.iscr.domain.Reservation">
        <id property="reservationId" column="reservation_id"/>
        <result property="userId" column="user_id"/>
        <result property="carId" column="car_id"/>
        <result property="startDate" column="start_date"/>
        <result property="endDate" column="end_date"/>
        <result property="totalPrice" column="total_price"/>
        <result property="status" column="status"/>
        <result property="createTime" column="create_time"/>
        <result property="updateTime" column="update_time"/>
        <result property="userName" column="user_name"/>
        <result property="carBrand" column="car_brand"/>
        <result property="carSeries" column="car_series"/>
        <result property="carModel" column="car_model"/>
    </resultMap>

    <sql id="selectReservationVo">
        SELECT r.reservation_id, r.user_id, r.car_id, r.start_date, r.end_date,
               r.total_price, r.status, r.create_time, r.update_time,
               u.user_name, c.brand AS car_brand, c.series AS car_series, c.model AS car_model
        FROM tb_reservation r
        LEFT JOIN tb_users u ON r.user_id = u.u_id
        LEFT JOIN tb_car c ON r.car_id = c.car_id
    </sql>

    <!-- 查询所有预约 -->
    <select id="selectAllReservations" resultMap="ReservationResult">
        <include refid="selectReservationVo"/>
        ORDER BY r.create_time DESC
    </select>

    <!-- 根据ID查询预约 -->
    <select id="selectReservationById" resultMap="ReservationResult">
        <include refid="selectReservationVo"/>
        WHERE r.reservation_id = #{reservationId}
    </select>

    <!-- 根据用户ID查询预约列表 -->
    <select id="selectReservationsByUserId" resultMap="ReservationResult">
        <include refid="selectReservationVo"/>
        WHERE r.user_id = #{userId}
        ORDER BY r.create_time DESC
    </select>

    <!-- 根据汽车ID查询预约列表 -->
    <select id="selectReservationsByCarId" resultMap="ReservationResult">
        <include refid="selectReservationVo"/>
        WHERE r.car_id = #{carId}
        ORDER BY r.create_time DESC
    </select>

    <!-- 根据条件查询预约列表 -->
    <select id="selectReservationList" parameterType="com.vsu.iscr.domain.Reservation" resultMap="ReservationResult">
        <include refid="selectReservationVo"/>
        <where>
            <if test="userId != null">
                AND r.user_id = #{userId}
            </if>
            <if test="carId != null">
                AND r.car_id = #{carId}
            </if>
            <if test="status != null">
                AND r.status = #{status}
            </if>
        </where>
        ORDER BY r.create_time DESC
    </select>

    <!-- 新增预约 -->
    <insert id="insertReservation" parameterType="com.vsu.iscr.domain.Reservation" useGeneratedKeys="true" keyProperty="reservationId">
        INSERT INTO tb_reservation (
            user_id, car_id, start_date, end_date, total_price, status
        ) VALUES (
            #{userId}, #{carId}, #{startDate}, #{endDate}, #{totalPrice}, #{status}
        )
    </insert>

    <!-- 更新预约信息 -->
    <update id="updateReservation" parameterType="com.vsu.iscr.domain.Reservation">
        UPDATE tb_reservation
        <set>
            <if test="startDate != null">start_date = #{startDate},</if>
            <if test="endDate != null">end_date = #{endDate},</if>
            <if test="totalPrice != null">total_price = #{totalPrice},</if>
            <if test="status != null">status = #{status},</if>
        </set>
        WHERE reservation_id = #{reservationId}
    </update>

    <!-- 删除预约 -->
    <delete id="deleteReservationById">
        DELETE FROM tb_reservation WHERE reservation_id = #{reservationId}
    </delete>

    <!-- 更新预约状态 -->
    <update id="updateReservationStatus">
        UPDATE tb_reservation SET status = #{status} WHERE reservation_id = #{reservationId}
    </update>

    <!-- 检查汽车在指定日期范围内是否已被预约 -->
    <select id="checkCarAvailability" resultType="int">
        SELECT COUNT(*)
        FROM tb_reservation
        WHERE car_id = #{carId}
          AND status NOT IN (2, 3)
          AND (
            (start_date &lt;= #{startDate} AND end_date &gt;= #{startDate})
            OR (start_date &lt;= #{endDate} AND end_date &gt;= #{endDate})
            OR (start_date &gt;= #{startDate} AND end_date &lt;= #{endDate})
          )
    </select>

</mapper>
